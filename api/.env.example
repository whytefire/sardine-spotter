# Server
PORT=4000
NODE_ENV=development

# Database — Azure SQL (production) or local SQL Server (dev)
DB_SERVER=sardinewatch-db.database.windows.net,1433
DB_NAME=SardineWatch
DB_USER=sardinewatch_admin
DB_PASSWORD=your_password_here
DB_TRUSTED_CONNECTION=false

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Maps
GOOGLE_MAPS_API_KEY=

# Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@sardinewatch.co.za

# URLs
APP_URL=https://sardinewatch.co.za
API_URL=https://sardinewatch-api.onrender.com
